{# Half-open interval [inicio, corte), on shared selected start weekdays.
   A range crossing midnight belongs to its start day. Equal times disable it.
   Use local calendar days, not +86400 seconds, including across midnight/DST. #}
{% macro daily_window(start_entity, end_entity) -%}
  {% set start = states(start_entity) %}
  {% set stop = states(end_entity) %}
  {% if start in ['unknown', 'unavailable', ''] or stop in ['unknown', 'unavailable', ''] or start == stop %}
    {{ {'valid': false, 'active': false, 'end': 0, 'next': 0} | to_json }}
  {% else %}
    {% set days = ['lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado', 'domingo'] %}
    {% set ns = namespace(selected=[], active=false, end=0, upcoming=0) %}
    {% for day in days %}
      {% if is_state('input_boolean.chacaico_dia_' ~ day, 'on') %}
        {% set ns.selected = ns.selected + [loop.index0] %}
      {% endif %}
    {% endfor %}
    {% set t = now() %}
    {% set a = today_at(start) %}
    {% set b = today_at(stop) %}
    {# Yesterday covers an overnight interval; +7 covers the next same weekday. #}
    {% for offset in range(-1, 8) %}
      {% set begin = a + timedelta(days=offset) %}
      {% set finish = b + timedelta(days=offset + (1 if a > b else 0)) %}
      {% if begin.weekday() in ns.selected %}
        {% if begin <= t < finish %}
          {% set ns.active = true %}
          {% set ns.end = as_timestamp(finish) %}
        {% elif begin > t and ns.upcoming == 0 %}
          {% set ns.upcoming = as_timestamp(begin) %}
        {% endif %}
      {% endif %}
    {% endfor %}
    {{ {'valid': true, 'active': ns.active, 'end': ns.end,
        'next': ns.end if ns.active else ns.upcoming} | to_json }}
  {% endif %}
{%- endmacro %}
